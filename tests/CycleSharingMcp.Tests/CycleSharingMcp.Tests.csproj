<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>false</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <RootNamespace>CycleSharingMcp.Tests</RootNamespace>
    <!-- 偽の取得元を使うテストは即座に終わるので、TestContext のキャンセルトークンは渡さない -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="CycleSharingMcp" />
    <Using Include="CycleSharingMcp.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CycleSharingMcp.Core\CycleSharingMcp.Core.csproj" />
    <ProjectReference Include="..\..\src\CycleSharingMcp\CycleSharingMcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

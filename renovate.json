{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "timezone": "Asia/Tokyo",
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "description": "GitHub Actions はまとめて上げる（pinact と同じくコミット SHA に固定したまま）",
      "groupName": "GitHub Actions",
      "matchManagers": ["github-actions"]
    },
    {
      "description": "mise.toml とワークフローの .NET SDK は同じ PR で上げる。setup-dotnet の dotnet-version も github-actions マネージャーが読むので、上のルールより後に置いて .NET SDK のグループに入れる",
      "groupName": ".NET SDK",
      "matchDatasources": ["dotnet-version"]
    },
    {
      "description": "dotnet/runtime から同時にリリースされる Microsoft.Extensions",
      "groupName": "Microsoft.Extensions",
      "matchPackageNames": ["Microsoft.Extensions.Hosting", "Microsoft.Extensions.Http"]
    },
    {
      "description": "MCP SDK 本体と ASP.NET Core 用は同じバージョンで揃える",
      "groupName": "ModelContextProtocol",
      "matchPackageNames": ["ModelContextProtocol", "ModelContextProtocol.*"]
    },
    {
      "description": "テストだけで使うパッケージ",
      "groupName": "テスト用パッケージ",
      "matchPackageNames": ["xunit.v3", "Microsoft.Extensions.TimeProvider.Testing"]
    }
  ]
}
